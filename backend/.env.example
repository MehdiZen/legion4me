# Port du serveur backend
PORT=3001

# Origine autorisée pour le CORS (frontend)
FRONTEND_URL=http://localhost:5173

# URL d'Ollama. Décommenter et ajuster si l'auto-détection échoue
# Sur Linux natif ou Mac : http://localhost:11434
# Sur WSL2 (auto-détecté, normalement inutile) : http://<ip-windows>:11434
# OLLAMA_URL=http://localhost:11434

# Chemin vers la base SQLite (créée automatiquement au premier démarrage)
# Un chemin relatif se résout par rapport au cwd du process, soit backend/ en dev
# (npm run dev), la racine du repo en prod (PM2). Utilise un chemin absolu
# si tu lances l'app depuis des contextes différents.
DB_PATH=./legion4me.db

# Clé API Tavily pour la recherche web (optionnelle, sans elle la recherche est désactivée)
# https://tavily.com
# TAVILY_API_KEY=tvly-...

# Alternative à OLLAMA_URL, avec l'hôte et le port d'Ollama sans le schéma (ex. localhost:11434)
# OLLAMA_HOST=localhost:11434

# URL de retour OAuth pour l'intégration Gmail (la valeur ci-dessous est celle par défaut)
# GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback
