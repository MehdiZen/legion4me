# Port du serveur backend
PORT=3001

# Origine autorisée pour le CORS (frontend)
FRONTEND_URL=http://localhost:5173

# URL d'Ollama — décommenter et ajuster si l'auto-détection échoue
# Sur Linux natif ou Mac : http://localhost:11434
# Sur WSL2 (auto-détecté, normalement inutile) : http://<ip-windows>:11434
# OLLAMA_URL=http://localhost:11434

# Chemin vers la base SQLite (créée automatiquement au premier démarrage)
DB_PATH=./asmodeus.db

# Clé API Tavily pour la recherche web — optionnel, sans ça la recherche est désactivée
# https://tavily.com
# TAVILY_API_KEY=tvly-...
